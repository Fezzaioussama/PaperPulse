# OpenRouter API Configuration
# For Vercel, set these in Project Settings > Environment Variables.
# Do not expose the API key with a VITE_ or REACT_APP_ prefix.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional public client default. This is safe because it is only a model id,
# not a secret. Users can still override it in the app Settings panel.
VITE_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
